execute_process(COMMAND "${GENERATOR}" generate "${WORK}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "native word synthesis/proof checks failed")
endif()
foreach(kind program resynthesized)
execute_process(COMMAND "${CXX}" -std=c++17 -O0 "${WORK}/${kind}/recovered.cpp" -o "${WORK}/${kind}/recovered"
    RESULT_VARIABLE status OUTPUT_FILE "${WORK}/${kind}/compile.log" ERROR_FILE "${WORK}/${kind}/compile.log")
if(NOT status EQUAL 0)
    file(READ "${WORK}/${kind}/compile.log" failure)
    message(FATAL_ERROR "synthesized arithmetic compilation failed: ${failure}")
endif()
execute_process(COMMAND "${WORK}/${kind}/recovered" INPUT_FILE "${WORK}/program/requests.jsonl"
    OUTPUT_FILE "${WORK}/${kind}/actual.jsonl" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "synthesized arithmetic execution failed")
endif()
execute_process(COMMAND "${GENERATOR}" verify "${WORK}/program/expected.jsonl" "${WORK}/${kind}/actual.jsonl" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "synthesized arithmetic differs from original symbolic equations")
endif()
endforeach()
