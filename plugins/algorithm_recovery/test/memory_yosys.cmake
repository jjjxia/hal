file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${GENERATOR}" "${WORK}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Native RAM fixture generation failed: ${status}")
endif()
execute_process(COMMAND "${IVERILOG}" -g2012 -s test -o test.vvp test.v "${MODEL}"
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Yosys primitive compilation failed: ${status}")
endif()
execute_process(COMMAND "${VVP}" test.vvp WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Yosys primitive simulation failed: ${status}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${WORK}/expected.txt" "${WORK}/observed.txt" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Native RAM disagrees with Yosys primitive")
endif()
foreach(mutant RANGE 0 2)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${WORK}/mutant${mutant}.txt" "${WORK}/observed.txt" RESULT_VARIABLE status)
    if(status EQUAL 0)
        message(FATAL_ERROR "RAM negative control ${mutant} was not detected")
    endif()
endforeach()
message(STATUS "Native RAM matches Yosys on 20480 bits; all three negative controls detected")
