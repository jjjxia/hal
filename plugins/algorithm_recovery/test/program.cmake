execute_process(COMMAND "${GENERATOR}" generate "${WORK}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "native C++ export/check generation failed")
endif()
foreach(kind operations frames order)
    execute_process(COMMAND "${CXX}" -std=c++17 -O0 "${WORK}/${kind}/recovered.cpp" -o "${WORK}/${kind}/recovered"
        RESULT_VARIABLE status OUTPUT_FILE "${WORK}/${kind}/compile.log" ERROR_FILE "${WORK}/${kind}/compile.log")
    if(NOT status EQUAL 0)
        file(READ "${WORK}/${kind}/compile.log" failure)
        message(FATAL_ERROR "standalone C++ compilation failed: ${failure}")
    endif()
    execute_process(COMMAND "${WORK}/${kind}/recovered" INPUT_FILE "${WORK}/${kind}/requests.jsonl"
        OUTPUT_FILE "${WORK}/${kind}/actual.jsonl" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "standalone C++ execution failed")
    endif()
    execute_process(COMMAND "${GENERATOR}" verify "${WORK}/${kind}/expected.jsonl" "${WORK}/${kind}/actual.jsonl" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "standalone C++ result mismatch")
    endif()
endforeach()
file(WRITE "${WORK}/invalid.jsonl" "{\"command\":\"kernel\",\"kernel\":0,\"inputs\":[\"-1\",\"0\"]}\n")
execute_process(COMMAND "${WORK}/operations/recovered" INPUT_FILE "${WORK}/invalid.jsonl" RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
    message(FATAL_ERROR "invalid standalone input accepted")
endif()
